# Local SQL Server settings. Never commit a real .env file.
PORT=5000
DB_AUTH=windows
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=MiraBeautyShopDb
# Set these only when DB_AUTH=sql.
DB_USER=YOUR_SQL_USERNAME
DB_PASSWORD=YOUR_SQL_PASSWORD
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD
